{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "ABC-LogicApp",
      "metadata": { "description": "Name of the Logic App." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Region. Use the same region as the Sentinel workspace." }
    },
    "logicAppState": {
      "type": "string",
      "defaultValue": "Disabled",
      "allowedValues": [ "Enabled", "Disabled" ],
      "metadata": { "description": "Deploy Disabled, authorize the Office 365 connection, then enable." }
    },
    "office365ConnectionName": {
      "type": "string",
      "defaultValue": "office365",
      "metadata": { "description": "Name of the Office 365 Outlook API connection." }
    },
    "sentinelConnectionName": {
      "type": "string",
      "defaultValue": "azuresentinel",
      "metadata": { "description": "Name of the Microsoft Sentinel API connection (managed identity)." }
    },
    "sentinelSubscriptionId": {
      "type": "string",
      "defaultValue": "[subscription().subscriptionId]",
      "metadata": { "description": "Subscription that contains the Sentinel workspace." }
    },
    "sentinelWorkspaceResourceGroup": {
      "type": "string",
      "defaultValue": "[resourceGroup().name]",
      "metadata": { "description": "Resource group that contains the Sentinel workspace." }
    },
    "sentinelWorkspaceId": {
      "type": "string",
      "metadata": { "description": "Log Analytics workspace ID (GUID), as used in the watchlist actions." }
    },
    "watchlistAlias": {
      "type": "string",
      "defaultValue": "ABC_Watchlist",
      "metadata": { "description": "Watchlist name and alias." }
    },
    "watchlistSearchKey": {
      "type": "string",
      "defaultValue": "server_id",
      "metadata": { "description": "CSV column used as the watchlist search key. Also checked in the header." }
    },
    "minimumLineCount": {
      "type": "int",
      "defaultValue": 5,
      "metadata": { "description": "Minimum number of lines the CSV must have. Raise to a realistic value." }
    },
    "allowedSenderAddress": {
      "type": "string",
      "defaultValue": "sender@example.com",
      "metadata": { "description": "Only emails from this address start the flow." }
    },
    "subjectFilter": {
      "type": "string",
      "defaultValue": "ABC Server List",
      "metadata": { "description": "Email subject text that triggers the flow." }
    },
    "notificationEmail": {
      "type": "string",
      "defaultValue": "team@example.com",
      "metadata": { "description": "Address that receives the rejection email." }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('sentinelConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[parameters('sentinelConnectionName')]",
        "parameterValueType": "Alternative",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]"
        }
      }
    },
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "[parameters('office365ConnectionName')]",
      "location": "[parameters('location')]",
      "kind": "V1",
      "properties": {
        "displayName": "[parameters('office365ConnectionName')]",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
        "[resourceId('Microsoft.Web/connections', parameters('sentinelConnectionName'))]"
      ],
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "[parameters('logicAppState')]",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": { "defaultValue": {}, "type": "Object" },
            "subscriptionId": { "defaultValue": "", "type": "String" },
            "workspaceResourceGroup": { "defaultValue": "", "type": "String" },
            "workspaceId": { "defaultValue": "", "type": "String" },
            "watchlistAlias": { "defaultValue": "", "type": "String" },
            "searchKeyColumn": { "defaultValue": "", "type": "String" },
            "minLineCount": { "defaultValue": 5, "type": "Int" },
            "notificationEmail": { "defaultValue": "", "type": "String" }
          },
          "triggers": {
            "When_a_new_email_arrives_(V3)": {
              "splitOn": "@triggerBody()?['value']",
              "type": "ApiConnectionNotification",
              "inputs": {
                "host": {
                  "connection": {
                    "name": "@parameters('$connections')['office365']['connectionId']"
                  }
                },
                "fetch": {
                  "pathTemplate": { "template": "/v3/Mail/OnNewEmail" },
                  "method": "get",
                  "queries": {
                    "from": "[parameters('allowedSenderAddress')]",
                    "importance": "Any",
                    "fetchOnlyWithAttachment": true,
                    "includeAttachments": true,
                    "subjectFilter": "[parameters('subjectFilter')]",
                    "folderPath": "Inbox"
                  }
                },
                "subscribe": {
                  "body": { "NotificationUrl": "@listCallbackUrl()" },
                  "pathTemplate": { "template": "/GraphMailSubscriptionPoke/$subscriptions" },
                  "method": "post",
                  "queries": {
                    "importance": "Any",
                    "fetchOnlyWithAttachment": true,
                    "folderPath": "Inbox"
                  }
                }
              }
            }
          },
          "actions": {
            "For_each": {
              "foreach": "@coalesce(triggerBody()?['attachments'], json('[]'))",
              "runAfter": {},
              "type": "Foreach",
              "runtimeConfiguration": {
                "concurrency": { "repetitions": 1 }
              },
              "actions": {
                "Condition": {
                  "type": "If",
                  "expression": {
                    "and": [
                      {
                        "endsWith": [
                          "@toLower(items('For_each')?['name'])",
                          ".csv"
                        ]
                      }
                    ]
                  },
                  "actions": {
                    "Compose": {
                      "type": "Compose",
                      "inputs": "@replace(base64ToString(items('For_each')?['contentBytes']), uriComponentToString('%EF%BB%BF'), '')"
                    },
                    "Is_valid_CSV": {
                      "type": "If",
                      "runAfter": {
                        "Compose": [ "Succeeded" ]
                      },
                      "expression": {
                        "and": [
                          {
                            "equals": [
                              "@startsWith(replace(outputs('Compose'), decodeUriComponent('%22'), ''), parameters('searchKeyColumn'))",
                              true
                            ]
                          },
                          {
                            "greater": [
                              "@length(split(outputs('Compose'), decodeUriComponent('%0A')))",
                              "@parameters('minLineCount')"
                            ]
                          }
                        ]
                      },
                      "actions": {
                        "Watchlists_-_Delete_a_Watchlist_(V2)": {
                          "type": "ApiConnection",
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                              }
                            },
                            "method": "delete",
                            "path": "/V2/Watchlists/subscriptions/@{encodeURIComponent(parameters('subscriptionId'))}/resourceGroups/@{encodeURIComponent(parameters('workspaceResourceGroup'))}/workspaces/@{encodeURIComponent(parameters('workspaceId'))}/watchlists/@{encodeURIComponent(parameters('watchlistAlias'))}"
                          }
                        },
                        "Delay": {
                          "type": "Wait",
                          "runAfter": {
                            "Watchlists_-_Delete_a_Watchlist_(V2)": [ "Succeeded", "Failed" ]
                          },
                          "inputs": {
                            "interval": { "count": 2, "unit": "Minute" }
                          }
                        },
                        "WL_body": {
                          "type": "Compose",
                          "runAfter": {
                            "Delay": [ "Succeeded" ]
                          },
                          "inputs": {
                            "displayName": "@parameters('watchlistAlias')",
                            "description": "Auto-refreshed from emailed CSV",
                            "source": "Local file",
                            "itemsSearchKey": "@parameters('searchKeyColumn')",
                            "rawContent": "@outputs('Compose')"
                          }
                        },
                        "Watchlists_-_Create_or_update_a_Watchlist_with_data_(Raw_Content)": {
                          "type": "ApiConnection",
                          "runAfter": {
                            "WL_body": [ "Succeeded" ]
                          },
                          "inputs": {
                            "host": {
                              "connection": {
                                "name": "@parameters('$connections')['azuresentinel']['connectionId']"
                              }
                            },
                            "method": "put",
                            "body": "@outputs('WL_body')",
                            "path": "/Watchlists/subscriptions/@{encodeURIComponent(parameters('subscriptionId'))}/resourceGroups/@{encodeURIComponent(parameters('workspaceResourceGroup'))}/workspaces/@{encodeURIComponent(parameters('workspaceId'))}/watchlists/@{encodeURIComponent(parameters('watchlistAlias'))}"
                          }
                        }
                      },
                      "else": {
                        "actions": {
                          "Send_an_email_(V2)": {
                            "type": "ApiConnection",
                            "inputs": {
                              "host": {
                                "connection": {
                                  "name": "@parameters('$connections')['office365']['connectionId']"
                                }
                              },
                              "method": "post",
                              "body": {
                                "To": "@parameters('notificationEmail')",
                                "Subject": "Watchlist refresh REJECTED",
                                "Body": "<p>Attachment failed validation. Watchlist not changed. @{item()?['name']}</p>",
                                "Importance": "Normal"
                              },
                              "path": "/v2/Mail"
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  }
                }
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "$connections": {
            "value": {
              "office365": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'office365')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('office365ConnectionName'))]",
                "connectionName": "office365"
              },
              "azuresentinel": {
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'azuresentinel')]",
                "connectionId": "[resourceId('Microsoft.Web/connections', parameters('sentinelConnectionName'))]",
                "connectionName": "azuresentinel",
                "connectionProperties": {
                  "authentication": {
                    "type": "ManagedServiceIdentity"
                  }
                }
              }
            }
          },
          "subscriptionId": { "value": "[parameters('sentinelSubscriptionId')]" },
          "workspaceResourceGroup": { "value": "[parameters('sentinelWorkspaceResourceGroup')]" },
          "workspaceId": { "value": "[parameters('sentinelWorkspaceId')]" },
          "watchlistAlias": { "value": "[parameters('watchlistAlias')]" },
          "searchKeyColumn": { "value": "[parameters('watchlistSearchKey')]" },
          "minLineCount": { "value": "[parameters('minimumLineCount')]" },
          "notificationEmail": { "value": "[parameters('notificationEmail')]" }
        }
      }
    }
  ],
  "outputs": {
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
