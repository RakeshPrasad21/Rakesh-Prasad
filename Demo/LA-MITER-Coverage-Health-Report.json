{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Weekly Microsoft Sentinel health report Logic App: Unmapped analytics rules, Disabled analytics rules (with High/Medium/Low severity breakdown), Connector health issues, MITRE ATT&CK per-tactic technique coverage (Most/Least Covered Tactics), a dynamic Attention Required list, an Affected Items list, a static recommendation, and a link to the Sentinel portal."
  },
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "LA-MITRE-Coverage-Health-Report",
      "metadata": { "description": "Name of the Logic App (Consumption)." }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": { "description": "Location for the Logic App." }
    },
    "sentinelSubscriptionId": {
      "type": "string",
      "metadata": { "description": "Subscription ID that contains the Microsoft Sentinel (Log Analytics) workspace." }
    },
    "sentinelResourceGroupName": {
      "type": "string",
      "metadata": { "description": "Resource group that contains the Microsoft Sentinel workspace." }
    },
    "sentinelWorkspaceName": {
      "type": "string",
      "metadata": { "description": "Name of the Log Analytics workspace with Microsoft Sentinel enabled." }
    },
    "recurrenceInterval": {
      "type": "int",
      "defaultValue": 1,
      "metadata": { "description": "Runs every N week(s). Default 1 = weekly." }
    },
    "connectorHealthLookbackDays": {
      "type": "int",
      "defaultValue": 7,
      "metadata": { "description": "How many days back to check the SentinelHealth table for data connector failures. Requires Sentinel health monitoring (preview) to be enabled on the workspace." }
    }
  },
  "variables": {},
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "sentinelSubscriptionId": { "type": "string" },
            "sentinelResourceGroupName": { "type": "string" },
            "sentinelWorkspaceName": { "type": "string" },
            "recurrenceInterval": { "type": "int" },
            "connectorHealthLookbackDays": { "type": "int" }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Week",
                "interval": "@parameters('recurrenceInterval')"
              }
            }
          },
          "actions": {
            "List_Analytics_Rules": {
              "type": "Http",
              "runAfter": {},
              "inputs": {
                "method": "GET",
                "uri": "@concat('https://management.azure.com/subscriptions/', parameters('sentinelSubscriptionId'), '/resourceGroups/', parameters('sentinelResourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('sentinelWorkspaceName'), '/providers/Microsoft.SecurityInsights/alertRules?api-version=2023-11-01')",
                "authentication": {
                  "type": "ManagedServiceIdentity"
                }
              }
            },
            "Initialize_AllRules": {
              "type": "InitializeVariable",
              "runAfter": { "List_Analytics_Rules": [ "Succeeded" ] },
              "inputs": {
                "variables": [
                  {
                    "name": "AllRules",
                    "type": "array",
                    "value": "@body('List_Analytics_Rules')?['value']"
                  }
                ]
              }
            },
            "Initialize_TacticDefinitions": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_AllRules": [ "Succeeded" ] },
              "inputs": {
                "variables": [
                  {
                    "name": "TacticDefinitions",
                    "type": "array",
                    "value": [
                      { "key": "Reconnaissance", "label": "Reconnaissance" },
                      { "key": "ResourceDevelopment", "label": "Resource Development" },
                      { "key": "InitialAccess", "label": "Initial Access" },
                      { "key": "Execution", "label": "Execution" },
                      { "key": "Persistence", "label": "Persistence" },
                      { "key": "PrivilegeEscalation", "label": "Privilege Escalation" },
                      { "key": "DefenseEvasion", "label": "Defense Evasion" },
                      { "key": "CredentialAccess", "label": "Credential Access" },
                      { "key": "Discovery", "label": "Discovery" },
                      { "key": "LateralMovement", "label": "Lateral Movement" },
                      { "key": "Collection", "label": "Collection" },
                      { "key": "CommandAndControl", "label": "Command and Control" },
                      { "key": "Exfiltration", "label": "Exfiltration" },
                      { "key": "Impact", "label": "Impact" }
                    ]
                  }
                ]
              }
            },
            "Initialize_TacticCoverage": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_TacticDefinitions": [ "Succeeded" ] },
              "inputs": {
                "variables": [ { "name": "TacticCoverage", "type": "array", "value": [] } ]
              }
            },
            "Initialize_TacticTechniques": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_TacticCoverage": [ "Succeeded" ] },
              "inputs": {
                "variables": [ { "name": "TacticTechniques", "type": "array", "value": [] } ]
              }
            },
            "Initialize_TacticTechniquesNext": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_TacticTechniques": [ "Succeeded" ] },
              "inputs": {
                "variables": [ { "name": "TacticTechniquesNext", "type": "array", "value": [] } ]
              }
            },
            "Initialize_Top1Tactic": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_TacticTechniquesNext": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Top1Tactic", "type": "string", "value": "" } ] }
            },
            "Initialize_Top1Count": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Top1Tactic": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Top1Count", "type": "integer", "value": -1 } ] }
            },
            "Initialize_Top2Tactic": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Top1Count": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Top2Tactic", "type": "string", "value": "" } ] }
            },
            "Initialize_Top2Count": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Top2Tactic": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Top2Count", "type": "integer", "value": -1 } ] }
            },
            "Initialize_Bottom1Tactic": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Top2Count": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Bottom1Tactic", "type": "string", "value": "" } ] }
            },
            "Initialize_Bottom1Count": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Bottom1Tactic": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Bottom1Count", "type": "integer", "value": 999999 } ] }
            },
            "Initialize_Bottom2Tactic": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Bottom1Count": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Bottom2Tactic", "type": "string", "value": "" } ] }
            },
            "Initialize_Bottom2Count": {
              "type": "InitializeVariable",
              "runAfter": { "Initialize_Bottom2Tactic": [ "Succeeded" ] },
              "inputs": { "variables": [ { "name": "Bottom2Count", "type": "integer", "value": 999999 } ] }
            },
            "Filter_Unmapped_Rules": {
              "type": "Query",
              "runAfter": { "Initialize_Bottom2Count": [ "Succeeded" ] },
              "inputs": {
                "from": "@variables('AllRules')",
                "where": "@equals(length(coalesce(item()?['properties']?['tactics'], json('[]'))), 0)"
              }
            },
            "Filter_Disabled_Rules": {
              "type": "Query",
              "runAfter": { "Filter_Unmapped_Rules": [ "Succeeded" ] },
              "inputs": {
                "from": "@variables('AllRules')",
                "where": "@equals(item()?['properties']?['enabled'], false)"
              }
            },
            "Filter_Mapped_Enabled_Rules": {
              "type": "Query",
              "runAfter": { "Filter_Disabled_Rules": [ "Succeeded" ] },
              "inputs": {
                "from": "@variables('AllRules')",
                "where": "@and(greater(length(coalesce(item()?['properties']?['tactics'], json('[]'))), 0), equals(item()?['properties']?['enabled'], true))"
              }
            },
            "Filter_Disabled_High": {
              "type": "Query",
              "runAfter": { "Filter_Mapped_Enabled_Rules": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Filter_Disabled_Rules')",
                "where": "@equals(item()?['properties']?['severity'], 'High')"
              }
            },
            "Filter_Disabled_Medium": {
              "type": "Query",
              "runAfter": { "Filter_Disabled_High": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Filter_Disabled_Rules')",
                "where": "@equals(item()?['properties']?['severity'], 'Medium')"
              }
            },
            "Filter_Disabled_Low": {
              "type": "Query",
              "runAfter": { "Filter_Disabled_Medium": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Filter_Disabled_Rules')",
                "where": "@equals(item()?['properties']?['severity'], 'Low')"
              }
            },
            "Compose_DisabledSeverityCounts": {
              "type": "Compose",
              "runAfter": { "Filter_Disabled_Low": [ "Succeeded" ] },
              "inputs": {
                "high": "@length(body('Filter_Disabled_High'))",
                "medium": "@length(body('Filter_Disabled_Medium'))",
                "low": "@length(body('Filter_Disabled_Low'))"
              }
            },
            "Select_HighSeverityLines": {
              "type": "Select",
              "runAfter": { "Compose_DisabledSeverityCounts": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Filter_Disabled_High')",
                "select": "@concat('\u26a0 ', coalesce(item()?['properties']?['displayName'], item()?['name']), ' \u2014 high-severity rule disabled')"
              }
            },
            "Compose_HighSeverityBlock": {
              "type": "Compose",
              "runAfter": { "Select_HighSeverityLines": [ "Succeeded" ] },
              "inputs": "@if(equals(length(body('Select_HighSeverityLines')), 0), '', concat(join(body('Select_HighSeverityLines'), '\n'), '\n'))"
            },
            "Get_Workspace_Details": {
              "type": "Http",
              "runAfter": { "Compose_HighSeverityBlock": [ "Succeeded" ] },
              "inputs": {
                "method": "GET",
                "uri": "@concat('https://management.azure.com/subscriptions/', parameters('sentinelSubscriptionId'), '/resourceGroups/', parameters('sentinelResourceGroupName'), '/providers/Microsoft.OperationalInsights/workspaces/', parameters('sentinelWorkspaceName'), '?api-version=2022-10-01')",
                "authentication": {
                  "type": "ManagedServiceIdentity"
                }
              }
            },
            "Query_Connector_Health": {
              "type": "Http",
              "runAfter": { "Get_Workspace_Details": [ "Succeeded" ] },
              "description": "Queries the SentinelHealth table for data connector failures. Requires Sentinel health monitoring (preview) enabled on the workspace.",
              "inputs": {
                "method": "POST",
                "uri": "@concat('https://api.loganalytics.io/v1/workspaces/', body('Get_Workspace_Details')?['properties']?['customerId'], '/query')",
                "headers": {
                  "Content-Type": "application/json"
                },
                "body": {
                  "query": "@concat('SentinelHealth | where TimeGenerated > ago(', string(parameters('connectorHealthLookbackDays')), 'd) | where SentinelResourceKind == ''DataConnector'' | where Status == ''Failure'' | summarize arg_max(TimeGenerated, *) by SentinelResourceName | project AffectedItem = SentinelResourceName')"
                },
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "https://api.loganalytics.io/"
                }
              }
            },
            "Select_Connector_Issue_Names": {
              "type": "Select",
              "runAfter": { "Query_Connector_Health": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Query_Connector_Health')?['tables'][0]?['rows']",
                "select": "@item()?[0]"
              }
            },
            "Compose_IssueCounts": {
              "type": "Compose",
              "runAfter": { "Select_Connector_Issue_Names": [ "Succeeded" ] },
              "inputs": {
                "unmappedRules": "@length(body('Filter_Unmapped_Rules'))",
                "disabledRules": "@length(body('Filter_Disabled_Rules'))",
                "connectorHealthIssues": "@length(body('Select_Connector_Issue_Names'))"
              }
            },
            "Select_Unmapped_Items": {
              "type": "Select",
              "runAfter": { "Compose_IssueCounts": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Filter_Unmapped_Rules')",
                "select": {
                  "name": "@coalesce(item()?['properties']?['displayName'], item()?['name'])",
                  "issue": "No MITRE ATT&CK mapping"
                }
              }
            },
            "Select_Disabled_Items": {
              "type": "Select",
              "runAfter": { "Select_Unmapped_Items": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Filter_Disabled_Rules')",
                "select": {
                  "name": "@coalesce(item()?['properties']?['displayName'], item()?['name'])",
                  "issue": "Analytics rule disabled"
                }
              }
            },
            "Select_Connector_Items": {
              "type": "Select",
              "runAfter": { "Select_Disabled_Items": [ "Succeeded" ] },
              "inputs": {
                "from": "@body('Select_Connector_Issue_Names')",
                "select": {
                  "name": "@item()",
                  "issue": "Connector offline"
                }
              }
            },
            "Compose_AffectedItems": {
              "type": "Compose",
              "runAfter": { "Select_Connector_Items": [ "Succeeded" ] },
              "inputs": "@union(union(body('Select_Unmapped_Items'), body('Select_Disabled_Items')), body('Select_Connector_Items'))"
            },
            "Select_AffectedItemLines": {
              "type": "Select",
              "runAfter": { "Compose_AffectedItems": [ "Succeeded" ] },
              "inputs": {
                "from": "@outputs('Compose_AffectedItems')",
                "select": "@concat(item()?['name'], '\nIssue: ', item()?['issue'])"
              }
            },
            "Compose_AffectedItemsMarkdown": {
              "type": "Compose",
              "runAfter": { "Select_AffectedItemLines": [ "Succeeded" ] },
              "inputs": "@if(equals(length(outputs('Compose_AffectedItems')), 0), 'No issues identified this period.', join(body('Select_AffectedItemLines'), '\n\n'))"
            },
            "Compose_PortalLink": {
              "type": "Compose",
              "runAfter": { "Compose_AffectedItemsMarkdown": [ "Succeeded" ] },
              "inputs": "@concat('https://portal.azure.com/#blade/Microsoft_Azure_Security_Insights/MainMenuBlade/0/id/', uriComponent(concat('/subscriptions/', parameters('sentinelSubscriptionId'), '/resourcegroups/', parameters('sentinelResourceGroupName'), '/providers/microsoft.operationalinsights/workspaces/', parameters('sentinelWorkspaceName'))))"
            },
            "Foreach_Tactic": {
              "type": "Foreach",
              "foreach": "@variables('TacticDefinitions')",
              "runAfter": { "Compose_PortalLink": [ "Succeeded" ] },
              "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
              "actions": {
                "Set_TacticTechniques_Empty": {
                  "type": "SetVariable",
                  "runAfter": {},
                  "inputs": { "name": "TacticTechniques", "value": [] }
                },
                "Filter_Rules_For_Tactic": {
                  "type": "Query",
                  "runAfter": { "Set_TacticTechniques_Empty": [ "Succeeded" ] },
                  "inputs": {
                    "from": "@body('Filter_Mapped_Enabled_Rules')",
                    "where": "@contains(coalesce(item()?['properties']?['tactics'], json('[]')), items('Foreach_Tactic')?['key'])"
                  }
                },
                "Foreach_Rule_In_Tactic": {
                  "type": "Foreach",
                  "foreach": "@body('Filter_Rules_For_Tactic')",
                  "runAfter": { "Filter_Rules_For_Tactic": [ "Succeeded" ] },
                  "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
                  "actions": {
                    "Union_Rule_Techniques": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": {
                        "name": "TacticTechniquesNext",
                        "value": "@union(variables('TacticTechniques'), coalesce(item()?['properties']?['techniques'], json('[]')))"
                      }
                    },
                    "Copy_Union_Result": {
                      "type": "SetVariable",
                      "runAfter": { "Union_Rule_Techniques": [ "Succeeded" ] },
                      "inputs": { "name": "TacticTechniques", "value": "@variables('TacticTechniquesNext')" }
                    }
                  }
                },
                "Append_TacticCoverage": {
                  "type": "AppendToArrayVariable",
                  "runAfter": { "Foreach_Rule_In_Tactic": [ "Succeeded" ] },
                  "inputs": {
                    "name": "TacticCoverage",
                    "value": {
                      "tactic": "@items('Foreach_Tactic')?['label']",
                      "count": "@length(variables('TacticTechniques'))"
                    }
                  }
                }
              }
            },
            "Foreach_RankTactics": {
              "type": "Foreach",
              "foreach": "@variables('TacticCoverage')",
              "runAfter": { "Foreach_Tactic": [ "Succeeded" ] },
              "runtimeConfiguration": { "concurrency": { "repetitions": 1 } },
              "actions": {
                "Condition_Top": {
                  "type": "If",
                  "runAfter": {},
                  "expression": "@greater(item()?['count'], variables('Top1Count'))",
                  "actions": {
                    "Shift_Top2Tactic": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": { "name": "Top2Tactic", "value": "@variables('Top1Tactic')" }
                    },
                    "Shift_Top2Count": {
                      "type": "SetVariable",
                      "runAfter": { "Shift_Top2Tactic": [ "Succeeded" ] },
                      "inputs": { "name": "Top2Count", "value": "@variables('Top1Count')" }
                    },
                    "Set_Top1Tactic": {
                      "type": "SetVariable",
                      "runAfter": { "Shift_Top2Count": [ "Succeeded" ] },
                      "inputs": { "name": "Top1Tactic", "value": "@item()?['tactic']" }
                    },
                    "Set_Top1Count": {
                      "type": "SetVariable",
                      "runAfter": { "Set_Top1Tactic": [ "Succeeded" ] },
                      "inputs": { "name": "Top1Count", "value": "@item()?['count']" }
                    }
                  },
                  "else": {
                    "actions": {
                      "Condition_Top2": {
                        "type": "If",
                        "runAfter": {},
                        "expression": "@greater(item()?['count'], variables('Top2Count'))",
                        "actions": {
                          "Set_Top2Tactic_From_Item": {
                            "type": "SetVariable",
                            "runAfter": {},
                            "inputs": { "name": "Top2Tactic", "value": "@item()?['tactic']" }
                          },
                          "Set_Top2Count_From_Item": {
                            "type": "SetVariable",
                            "runAfter": { "Set_Top2Tactic_From_Item": [ "Succeeded" ] },
                            "inputs": { "name": "Top2Count", "value": "@item()?['count']" }
                          }
                        },
                        "else": { "actions": {} }
                      }
                    }
                  }
                },
                "Condition_Bottom": {
                  "type": "If",
                  "runAfter": { "Condition_Top": [ "Succeeded" ] },
                  "expression": "@less(item()?['count'], variables('Bottom1Count'))",
                  "actions": {
                    "Shift_Bottom2Tactic": {
                      "type": "SetVariable",
                      "runAfter": {},
                      "inputs": { "name": "Bottom2Tactic", "value": "@variables('Bottom1Tactic')" }
                    },
                    "Shift_Bottom2Count": {
                      "type": "SetVariable",
                      "runAfter": { "Shift_Bottom2Tactic": [ "Succeeded" ] },
                      "inputs": { "name": "Bottom2Count", "value": "@variables('Bottom1Count')" }
                    },
                    "Set_Bottom1Tactic": {
                      "type": "SetVariable",
                      "runAfter": { "Shift_Bottom2Count": [ "Succeeded" ] },
                      "inputs": { "name": "Bottom1Tactic", "value": "@item()?['tactic']" }
                    },
                    "Set_Bottom1Count": {
                      "type": "SetVariable",
                      "runAfter": { "Set_Bottom1Tactic": [ "Succeeded" ] },
                      "inputs": { "name": "Bottom1Count", "value": "@item()?['count']" }
                    }
                  },
                  "else": {
                    "actions": {
                      "Condition_Bottom2": {
                        "type": "If",
                        "runAfter": {},
                        "expression": "@less(item()?['count'], variables('Bottom2Count'))",
                        "actions": {
                          "Set_Bottom2Tactic_From_Item": {
                            "type": "SetVariable",
                            "runAfter": {},
                            "inputs": { "name": "Bottom2Tactic", "value": "@item()?['tactic']" }
                          },
                          "Set_Bottom2Count_From_Item": {
                            "type": "SetVariable",
                            "runAfter": { "Set_Bottom2Tactic_From_Item": [ "Succeeded" ] },
                            "inputs": { "name": "Bottom2Count", "value": "@item()?['count']" }
                          }
                        },
                        "else": { "actions": {} }
                      }
                    }
                  }
                }
              }
            },
            "Select_TacticFacts": {
              "type": "Select",
              "runAfter": { "Foreach_RankTactics": [ "Succeeded" ] },
              "inputs": {
                "from": "@variables('TacticCoverage')",
                "select": {
                  "title": "@item()?['tactic']",
                  "value": "@string(item()?['count'])"
                }
              }
            },
            "Compose_MostCoveredText": {
              "type": "Compose",
              "runAfter": { "Select_TacticFacts": [ "Succeeded" ] },
              "inputs": "@concat(variables('Top1Tactic'), ' \u2014 ', string(variables('Top1Count')), ' techniques\n', variables('Top2Tactic'), ' \u2014 ', string(variables('Top2Count')), ' techniques')"
            },
            "Compose_LeastCoveredText": {
              "type": "Compose",
              "runAfter": { "Compose_MostCoveredText": [ "Succeeded" ] },
              "inputs": "@concat(variables('Bottom1Tactic'), ' \u2014 ', string(variables('Bottom1Count')), ' techniques\n', variables('Bottom2Tactic'), ' \u2014 ', string(variables('Bottom2Count')), ' techniques')"
            },
            "Compose_AttentionRequired": {
              "type": "Compose",
              "runAfter": { "Compose_LeastCoveredText": [ "Succeeded" ] },
              "inputs": "@concat(outputs('Compose_HighSeverityBlock'), '\u26a0 ', variables('Bottom1Tactic'), ' has the lowest technique coverage (', string(variables('Bottom1Count')), ' techniques mapped)\n', '\u26a0 ', variables('Bottom2Tactic'), ' has low technique coverage (', string(variables('Bottom2Count')), ' techniques mapped)')"
            },
            "Compose_AdaptiveCard": {
              "type": "Compose",
              "runAfter": { "Compose_AttentionRequired": [ "Succeeded" ] },
              "description": "Builds the Teams Adaptive Card payload. No Teams connector/action is wired up - add a 'Post adaptive card in a chat or channel' action after this one and use outputs('Compose_AdaptiveCard') as the card.",
              "inputs": {
                "type": "AdaptiveCard",
                "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
                "version": "1.4",
                "body": [
                  {
                    "type": "TextBlock",
                    "size": "Large",
                    "weight": "Bolder",
                    "text": "Microsoft Sentinel - Weekly Detection Health Report",
                    "wrap": true
                  },
                  {
                    "type": "TextBlock",
                    "isSubtle": true,
                    "spacing": "None",
                    "wrap": true,
                    "text": "Reporting Date: @{utcNow('yyyy-MM-dd')} (Weekly)"
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "size": "Medium",
                    "spacing": "Medium",
                    "text": "Detection Governance Health"
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      { "title": "Unmapped Analytics Rules", "value": "@{string(outputs('Compose_IssueCounts')?['unmappedRules'])}" },
                      { "title": "Disabled Analytics Rules", "value": "@{string(outputs('Compose_IssueCounts')?['disabledRules'])}" },
                      { "title": "Connector Health Issues", "value": "@{string(outputs('Compose_IssueCounts')?['connectorHealthIssues'])}" }
                    ]
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "size": "Medium",
                    "spacing": "Medium",
                    "text": "MITRE ATT&CK Coverage Health"
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "wrap": true,
                    "spacing": "Small",
                    "text": "Most Covered Tactics (by techniques mapped)"
                  },
                  {
                    "type": "TextBlock",
                    "wrap": true,
                    "spacing": "None",
                    "text": "@{outputs('Compose_MostCoveredText')}"
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "wrap": true,
                    "spacing": "Small",
                    "text": "Least Covered Tactics (by techniques mapped)"
                  },
                  {
                    "type": "TextBlock",
                    "wrap": true,
                    "spacing": "None",
                    "text": "@{outputs('Compose_LeastCoveredText')}"
                  },
                  {
                    "type": "FactSet",
                    "spacing": "Medium",
                    "facts": "@body('Select_TacticFacts')"
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "size": "Medium",
                    "spacing": "Medium",
                    "text": "Disabled Rule Risk"
                  },
                  {
                    "type": "FactSet",
                    "facts": [
                      { "title": "High Severity Rules Disabled", "value": "@{string(outputs('Compose_DisabledSeverityCounts')?['high'])}" },
                      { "title": "Medium Severity Rules Disabled", "value": "@{string(outputs('Compose_DisabledSeverityCounts')?['medium'])}" },
                      { "title": "Low Severity Rules Disabled", "value": "@{string(outputs('Compose_DisabledSeverityCounts')?['low'])}" }
                    ]
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "size": "Medium",
                    "spacing": "Medium",
                    "text": "Attention Required"
                  },
                  {
                    "type": "TextBlock",
                    "wrap": true,
                    "text": "@{outputs('Compose_AttentionRequired')}"
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "size": "Medium",
                    "spacing": "Medium",
                    "text": "Affected Items"
                  },
                  {
                    "type": "TextBlock",
                    "wrap": true,
                    "text": "@{outputs('Compose_AffectedItemsMarkdown')}"
                  },
                  {
                    "type": "TextBlock",
                    "weight": "Bolder",
                    "size": "Medium",
                    "spacing": "Medium",
                    "text": "Recommendation Action"
                  },
                  {
                    "type": "TextBlock",
                    "wrap": true,
                    "text": "Review and remediate the affected items to maintain ATT&CK and detection effectiveness."
                  }
                ],
                "actions": [
                  {
                    "type": "Action.OpenUrl",
                    "title": "Open Microsoft Sentinel",
                    "url": "@{outputs('Compose_PortalLink')}"
                  }
                ]
              }
            }
          },
          "outputs": {}
        },
        "parameters": {
          "sentinelSubscriptionId": { "value": "[parameters('sentinelSubscriptionId')]" },
          "sentinelResourceGroupName": { "value": "[parameters('sentinelResourceGroupName')]" },
          "sentinelWorkspaceName": { "value": "[parameters('sentinelWorkspaceName')]" },
          "recurrenceInterval": { "value": "[parameters('recurrenceInterval')]" },
          "connectorHealthLookbackDays": { "value": "[parameters('connectorHealthLookbackDays')]" }
        }
      }
    }
  ],
  "outputs": {
    "logicAppResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Logic/workflows', parameters('logicAppName'))]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Logic/workflows', parameters('logicAppName')), '2019-05-01', 'Full').identity.principalId]"
    }
  }
}
